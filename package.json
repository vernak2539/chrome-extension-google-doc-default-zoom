{
  "name": "google-workspace-zoom-extended",
  "displayName": "__MSG_extensionNameExtended__",
  "version": "0.15.4",
  "description": "__MSG_extensionDescription__",
  "license": "MIT WITH Commons-Clause",
  "author": "vernak2539",
  "repository": "github:vernak2539/chrome-extension-google-doc-default-zoom",
  "type": "module",
  "scripts": {
    "dev": "plasmo dev --tag=extended",
    "dev:base": "plasmo dev --tag=base",
    "test": "vitest",
    "test:e2e": "vitest run --config e2e/vitest.config.ts e2e/zoom-fixtures",
    "test:e2e:live": "vitest run --config e2e/vitest.config.ts e2e/zoom-live",
    "e2e:capture": "vitest run --config e2e/vitest.config.ts e2e/capture; status=$?; vitest run --config e2e/vitest.config.ts e2e/sanitize && exit $status",
    "build:base": "plasmo build --hoist --tag=base",
    "build:extended": "plasmo build --hoist --tag=extended",
    "build": "pnpm build:extended",
    "package:base": "plasmo package --tag=base",
    "package:extended": "plasmo package --tag=extended",
    "package": "pnpm package:extended",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "typecheck": "tsc --noEmit -p tsconfig.json --incremental false",
    "bundlesize": "bundlesize",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check:editions": "node bin/check-edition-build.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@picocss/pico": "^2.1.1",
    "@plasmohq/messaging": "^0.7.2",
    "@plasmohq/storage": "^1.15.0",
    "@sentry/browser": "^9.40.0",
    "@sentry/react": "^9.40.0",
    "classnames": "^2.5.1",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-aria-components": "^1.6.0",
    "react-dom": "18.2.0",
    "react-router-dom": "^7.14.1"
  },
  "devDependencies": {
    "@google-cloud/translate": "^9.2.0",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-links": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@types/chrome": "0.0.263",
    "@types/node": "22.x",
    "@types/react": "18.2.65",
    "@types/react-dom": "18.2.22",
    "@vitejs/plugin-react": "^6.3.0",
    "bundlesize2": "^0.0.35",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.44.0",
    "oxlint": "^1.59.0",
    "playwright": "^1.64.1",
    "prop-types": "^15.8.1",
    "storybook": "^10.6.7",
    "typescript": "5.8.3",
    "vite": "^8.3.8",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.1.1",
    "yargs": "^18.0.0"
  },
  "lint-staged": {
    "*.{json,css,md}": "oxfmt --write",
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxfmt --write",
      "oxlint --fix"
    ]
  },
  "packageManager": "pnpm@9.10.0",
  "pnpm": {
    "overrides": {
      "nanoid": "3.3.7"
    }
  },
  "manifest": {
    "name": "$PLASMO_PUBLIC_EXT_NAME",
    "default_locale": "en",
    "permissions": [
      "$DEBUGGER_PERMISSION"
    ],
    "browser_specific_settings": {
      "gecko": {
        "id": "$FIREFOX_EXT_ID"
      }
    }
  }
}
