{
  "name": "google-workspace-zoom-extended",
  "version": "0.15.4",
  "description": "__MSG_extensionDescription__",
  "license": "MIT WITH Commons-Clause",
  "author": "vernak2539",
  "repository": "github:vernak2539/chrome-extension-google-doc-default-zoom",
  "type": "module",
  "scripts": {
    "dev": "wxt --mode extended",
    "dev:base": "wxt --mode base",
    "test": "vitest",
    "test:e2e": "vitest run --config e2e/vitest.config.ts e2e/zoom-fixtures",
    "test:e2e:live": "vitest run --config e2e/vitest.config.ts e2e/zoom-live",
    "test:e2e:firefox": "vitest run --config e2e/vitest.config.ts --project firefox",
    "test:e2e:live:firefox": "vitest run --config e2e/vitest.config.ts --project firefox-live",
    "e2e:capture": "vitest run --config e2e/vitest.config.ts e2e/capture; status=$?; vitest run --config e2e/vitest.config.ts e2e/sanitize && exit $status",
    "build:base": "wxt build --mode base",
    "build:extended": "wxt build --mode extended",
    "build": "pnpm build:extended",
    "package:base": "wxt zip --mode base",
    "package:extended": "wxt zip --mode extended",
    "package": "pnpm package:extended",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "typecheck": "tsc --noEmit -p tsconfig.json --incremental false",
    "bundlesize": "bundlesize",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check:editions": "node bin/check-edition-build.mjs",
    "postinstall": "wxt prepare",
    "prepare": "husky"
  },
  "dependencies": {
    "@picocss/pico": "^2.1.1",
    "@sentry/browser": "^9.47.2",
    "@webext-core/messaging": "^4.0.1",
    "classnames": "^2.5.1",
    "react": "18.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@google-cloud/translate": "^10.3.0",
    "@puppeteer/browsers": "3.2.7",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-links": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@types/chrome": "0.3.7",
    "@types/node": "~22.20.5",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "bundlesize2": "^0.0.35",
    "husky": "^9.1.7",
    "jsdom": "31.0.1",
    "lint-staged": "17.6.1",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "playwright": "^1.65.1",
    "puppeteer-core": "25.18.1",
    "storybook": "^10.6.7",
    "typescript": "7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.1.1",
    "wxt": "0.21.5",
    "yargs": "^18.2.0"
  },
  "lint-staged": {
    "*.{json,css,md}": "oxfmt --write",
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxfmt --write",
      "oxlint --fix"
    ]
  },
  "packageManager": "pnpm@12.21.0",
  "pnpm": {
    "overrides": {
      "nanoid": "3.3.20"
    }
  }
}
